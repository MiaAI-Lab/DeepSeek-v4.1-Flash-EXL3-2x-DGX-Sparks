# DeepSeek-V4.1-Flash EXL3 — 2× DGX Spark (GB10 / SM121)
# Copy to .env and edit. ./start.sh does this for you on first run.

# --- nodes (edit these) ------------------------------------------------
HEAD_IP=10.0.0.1
WORKER_IP=10.0.0.2
# SSH user on the worker. Unset = same as the user running ./start.sh.
# Only set this when the worker account differs (e.g. WORKER_USER=zurih).
WORKER_USER=zurih
# WORKER_HOME=/home/zurih
# WORKER_SSH=zurih@10.0.0.2

# Direct CX7 QSFP (spark1 f1 ↔ spark2 f0 on this kit). NCCL cannot use the
# 10.0.0.x loopback aliases — without these pins ncclCommInitRank hangs.
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f0
# The RoCEv2 GID index is per-NIC. Inspect:
#   cat /sys/class/infiniband/<dev>/ports/1/gids/{0..7}
# NCCL_IB_GID_INDEX=3
# HEAD_GID=4
# WORKER_GID=3

# --- weights (local, not Hub) ------------------------------------------
# EXL3 2.9 bpw tree next to this recipe (39 shards, ~197 GiB).
# MODEL_HOST=/home/mia/NewModels/DeepSeek-V4.1-Flash-EXL3-2.9bpw/model
# Original native checkpoint: Engram tables were not quantized.
# --- weights ---------------------------------------------------------------
# EXL3 weights (39 shards, ~197 GiB) and the Engram tables (shards 47+48 of the
# original 48-shard checkpoint, ~95 GiB each). ./start.sh fetches whatever is
# missing before it boots; ./download.sh does the same without starting the
# server. Both are resumable. AUTO_DOWNLOAD=0 verifies only.
HF_MODEL_REPO=Mia-AiLab/DeepSeek-V4.1-Flash-EXL3-2.9bpw
HF_ENGRAM_REPO=deepseek-ai/DeepSeek-V4.1-Flash
AUTO_DOWNLOAD=1
# Where they land. Defaults sit next to this checkout; point ENGRAM_DIR at an
# existing DeepSeek-V4.1-Flash tree to skip the 190 GiB Engram fetch.
# MODEL_HOST=./model
ENGRAM_DIR=./engram-src
# Worker node-local mounts only used for WEIGHT_SYNC=zfs|rsync:
# WORKER_MODEL_DIR=/home/zurih/.cache/dsv41-flash-exl3/model
# WORKER_ENGRAM_DIR=/home/zurih/.cache/dsv41-flash-exl3/engram-src
EXPECTED_SHARDS=39

# Weight replica: nfs (default) = NFSv4 over CX7, no local copy on spark2.
# Same idea as https://github.com/MiaAI-Lab/DeepSeek-v4.1-Flash-DGX-Sparks
# (`./start.sh share`). Engram is only shards 47+48, not the 476 GiB tree.
# auto = nfs, then ZFS if datasets exist, then rsync.
# zfs = require snapshot/send/recv. rsync = copy EXL3 + slim Engram (~387 GiB).
WEIGHT_SYNC=nfs
NFS_SHARE=1
# Both are derived from the route to WORKER_IP: the export is served on the
# address this host reaches the worker from, and the ACL is that /24 plus
# WORKER_IP. Set them only if your worker mounts over a different link.
# NFS_SERVER_IP=10.0.22.1
# NFS_CLIENTS=10.0.0.2,10.0.22.0/24
# NFS_VOLUME_MODEL=dsv41-exl3-weights
# NFS_VOLUME_ENGRAM=dsv41-exl3-engram
# Host directory the recipe's own nfsd exports (hardlinks of EXL3 + slim Engram;
# same filesystem as MODEL_HOST/ENGRAM_SRC). The container's overlayfs /export
# is not exportable, so this must be a real directory. Default: CACHE_ROOT/nfs-export.
# NFS_EXPORT_ROOT=/home/you/.cache/vllm-dsv41-flash-exl3/nfs-export
# CX7 address of spark2 — bulk send must not use 10.0.0.2.
# ZFS_WORKER_IP=10.0.22.2
# ZFS_SSH=zurih@10.0.22.2
# Dataset names (head + worker). Engram dataset is shards 47+48 ONLY
# (~190 GiB), never the 476 GiB native tree.
ZFS_POOL=models
# ZFS_HEAD_MODEL_DS=models/dsv41-exl3
# ZFS_HEAD_ENGRAM_DS=models/dsv41-engram
# ZFS_WORKER_MODEL_DS=models/dsv41-exl3
# ZFS_WORKER_ENGRAM_DS=models/dsv41-engram
# Force the ~197 GiB + ~190 GiB rsync when not using ZFS:
# FORCE_SYNC=1

# --- serve -------------------------------------------------------------
# Public GHCR image (arm64/SM121, no login needed). start.sh pulls it, and
# rebuilds from this Dockerfile only when the overlay recipe stamp drifts
# (i.e. you edited Dockerfile/overlay after a git pull).
# Force a local build: BUILD=1 ./start.sh    Keep GHCR anyway: SKIP_BUILD=1
# Skip the pull: SKIP_PULL=1                 Skip copying to worker: SKIP_SHIP=1
IMAGE=ghcr.io/miaai-lab/deepseek-v4.1-flash-exl3-2x-dgx-sparks:2.9bpw
# How the image reaches the worker when it cannot pull it itself.
#   rsync  (default) stage a tar on the head, rsync it (resumable across a
#          dropped link), load it on the worker. Wants ~23 GiB scratch on the
#          head and the same again on the worker, plus room for the image.
#   stream docker save | ssh docker load. No scratch anywhere, but an
#          interrupted transfer restarts from zero.
#   auto   rsync, falling back to stream if the worker is short of disk.
IMAGE_SHIP=rsync
PORT=8888
TP=2
NNODES=2
MASTER_PORT=29521
QUANTIZATION=exl3
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
# E2 (EXL3_FAT_KERNEL) is K4/MCG-only. E3 v2 grouped kernels (overlay/e3v2) handle this mul1 K2/K3 tree:
# one gather + gate/up + down launch per layer for every expert above EXL3_TEMP_ROWS_FUSED rows.
EXL3_FAT_KERNEL=0
EXL3_FAT_GROUPED=1
# Fused exl3_moe rows per expert; experts above it take the E3 v2 grouped kernels (prefill).
# Measured 2026-09-12, 1536-token chunk, 384 experts: fused-only 34 ms/layer, cap 32 34 ms, cap 16 17 ms.
# Keep >= MAX_NUM_SEQS x (DSPARK_TOKENS+1) (=16) so a decode step stays one fused launch.
EXL3_TEMP_ROWS_FUSED=16
SERVED_MODEL_NAME=DeepSeek-v4.1-Flash-EXL3

# In-checkpoint DSpark (dspark_block_size=5). Not DFlash — no extra draft repo.
SPEC_METHOD=dspark
# 3 (measured 2026-09-12, prose x1: k=3 28 tok/s, k=5 25, none 23; x4 aggregate: none 54 > k=3 42).
# Interactive (<=2 chats): dspark k=3. Batch serving of 4 streams: SPEC_METHOD=none is faster.
DSPARK_TOKENS=3

# Native CSA2 KV is ~890 B/token FP4. Do not set GLM's fp8_ds_mla here.
# KV_CACHE_DTYPE=
# --- unified-memory budget (2x GB10, 121.7 GiB each) -----------------------
# EXL3 weights are ~99.5 GiB per rank (scripts/weight_budget.py) and every
# cudaMalloc is committed host memory. What is left (~22 GiB) has to hold the
# CUDA context, NCCL, the KV pool, prefill activations, CUDA graphs and the
# vLLM processes themselves. The 2026-09-11 boot exceeded it and both nodes
# wedged (HANDOFF.md). First clean boot targets: 128k context, 2k prefill
# chunk, a pinned 1 GiB KV pool. Raise one knob at a time and watch
# logs/memguard-head.log (low-water MemAvailable) before raising the next.
# 500k serves one long request at a time (improve.md §8): a 450k prefill ends with 2.2 GiB
# low-water on the head. Needs KV_CACHE_MEMORY_BYTES >= 2.0 GiB (one 500k request = 1.9 GiB).
# 600k is the validated setting on 2x GB10 and the shipped default: the 2.5 GiB pool below holds
# 774,400 tokens at this length (1.26x one 600k request) and a 601k prefill ends with 2.1 GiB
# low-water on the head (the memguard that threshold refers to is off by default). On a
# smaller budget drop this first
# (262144 was the earlier conservative default).
MAX_MODEL_LEN=600000
MAX_NUM_SEQS=2
# Prefill chunk. The V4.1 indexer scores every chunk row against the whole
# prefix, so the activation peak grows with chunk x context. With the vision
# tower on vLLM needs >= max image tokens + 1 = 1025 per chunk (1024 is rejected
# at boot); 1536 is the smallest round value. Do not drop below 1536 unless you
# also set LANGUAGE_MODEL_ONLY=1. Measured 2026-09-13 at 1536: long-context
# headroom is better than at 1024, not worse (450k prompt ends at 2.9 GiB head
# MemAvailable vs 2.2 GiB before) — the larger chunk finishes the prefill in
# fewer scheduler passes. 2048 was the earlier setting.
MAX_NUM_BATCHED_TOKENS=1536
# Cap one request's tokens per step (vLLM --long-prefill-token-threshold, GLM PR #157): a short chat
# sent during a 181k prefill otherwise waits for the whole prefill (216 s measured); with 1792 of the
# 2048 budget it answers in ~4 s and solo prefill loses ~6 %. Empty = off. Keep MNBT - THRESHOLD >= 256
# (1280 = 1536 - 256 at the shipped chunk).
LONG_PREFILL_TOKEN_THRESHOLD=1280
# With KV_CACHE_MEMORY_BYTES set this is only vLLM's startup sanity check
# (MemAvailable at init must be >= util x 121.69 GiB; 0.92 missed by 20 MB
# on the head once), not a budget.
GPU_MEM_UTIL=0.88
# Pinned KV pool (bytes). V4.1 KV is small (only the kv_source layers keep
# KV, ~1.63 KB/token), so 1 GiB (658k tokens) covers 4 x 128k (0.85 GiB); unpinned, vLLM would size the
# pool from host MemAvailable minus a profile run, which drifts with page
# cache on UMA. Empty = let vLLM profile.
KV_CACHE_MEMORY_BYTES=2684354560
# 64-token KV blocks: the SM12x DeepGEMM paged indexer kernel only takes 32 or 64
# states per block (128 dies on the first decode of the ratio-1 indexer layers).
KV_BLOCK_SIZE=64
# File-backed Engram row cache (GiB, split across layers 1 and 14) and the
# pinned per-rank scale shard (~1.5 GiB/layer). Both are anonymous host RAM
# in the worker process = GPU memory on GB10. Default off (native 3-Spark
# recipe finding: n-gram rows have ~0% reuse). Raise only with measured headroom.
# DSV41_CACHE_GIB=0
# DSV41_RESIDENT_SCALES=0
# DSV41_IO_THREADS=32
# Host memory guard (scripts/memguard.sh) and pre-launch headroom check.
# Memory watchdog. 0 = off (default): vLLM runs at ~4 GiB MemAvailable in
# normal use and never approaches the threshold, and the trips that did happen
# came from unrelated host processes — the guard then killed the server rather
# than the process that took the memory. Kernel fallback stays: --oom-score-adj
# 1000 means the OOM killer takes vLLM, not the desktop. 1 = arm it.
DSV41_MEM_GUARD=0
# DSV41_MEM_GUARD_GIB=1.5
# DSV41_BOOT_MARGIN_GIB=12
# Images are on by default (verified 2026-09-13 on 2x GB10). FlashInfer's SM120
# sparse-MLA prefill kernels have no variant for the vision-widened sliding window
# (128 + 1024 image tokens = 1152; the table stops at 128/192/256/512/1024/2048),
# so patch_sm120_block64.py pins max_image_tokens to 0 on SM12x and the window stays
# 128 wide. That clamp keys off device capability, not this flag, so it applies either
# way — it is what makes vision safe to run here, not what blocks it: every widened
# path is a guarded branch, so the 1152-wide kernel is simply never requested.
# In-image bidirectional visibility is genuinely off as a result; measured effect on
# OCR and multi-image attribution was nil, but there is no parity probe against the
# native checkpoint, so verify before trusting dense document work.
# Needs MAX_NUM_BATCHED_TOKENS >= 1536 above. Set to 1 for a text-only server.
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM='{"image":100}'

# --- API auth --------------------------------------------------------------
# VLLM_API_KEY=

# --- JIT caches / boot warmup ----------------------------------------------
# TRITON_HOST_CACHE=
# TILELANG_HOST_CACHE=
DSV41_BOOT_SHAPE_WARMUP=1
# DSV41_WARMUP_REQ_TIMEOUT=240
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=0
GLM53_SPINWAIT_MS=stock
# VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800

USE_HOST_NCCL=0
NCCL_IB_GID_INDEX=3
CG_ESTIMATE=1
NCCL_DEBUG=WARN
# UMA NCCL buffers (from the native DS4.1 3-Spark recipe).
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
# expandable_segments:True (GLM recipe default). Without it the allocator fragments as the
# per-chunk transients grow with the prefix (long prefill fell to 244 tok/s at 455k). The
# native SGLang recipe saw NaN logits with True on its stack; on this vLLM stack it is clean
# (smoke / sanity / 4 greedy streams / 100k-455k prompts, 2026-09-13). If garbage ever
# appears in greedy batches, set False and rely on DSV41_PREFILL_EMPTY_CACHE_* below.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Boot-time page-cache drop (posix_fadvise DONTNEED on the EXL3 shards after
# load): the GB10 driver allocates from MemFree and does not reclaim the page
# cache the mmap load leaves behind (NVRM out-of-memory with MemFree ~1 GiB
# while MemAvailable was ~9 GiB, boot 11 on 2026-09-12). 1 = drop (default).
DSV41_DROP_PAGE_CACHE=1
# 1 = skip the mixed prefill+decode sparse-MLA warm-up (kernels JIT on the
# first mixed batch instead). Escape hatch if that warm-up hangs the ranks.
DSV41_SKIP_MIXED_WARMUP=0

# Shared experts on the main stream (see .env): EXL3 kernels share one lock buffer.
VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
# 1 (default) = the DeepSeek V4.1 model runs its attention input projections,
# indexer and compressor on the main stream instead of three aux streams.
# exllamav3 keeps ONE lock buffer per device for every EXL3 kernel, so two
# EXL3 GEMMs in flight on different streams deadlock (boots 11-14, 2026-09-12).
DSV41_EXL3_SERIAL_STREAMS=1

# Sparse-indexer prefill gather workspace factor (entries = max_model_len x factor x 132 B).
# Empty = MAX_NUM_SEQS (the chunk planner's real bound); stock vLLM is 40 (2.6 GB at 500k).
DSV41_INDEXER_PREFILL_FACTOR=1
# Peak MB of one indexer logits launch (vLLM default 512); 256 trims ~256 MB of live memory per chunk.
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
# Release the allocator's cached blocks after every prefill chunk of sequences this long
# (native DS4.1 recipe's hook): long prompts otherwise grow reserved host memory with the
# square of the prompt (100k prefill hit the memguard at 500k context). 0 disables.
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
# Release only while MemAvailable after the chunk is below this many GiB (0 = every chunk).
DSV41_PREFILL_EMPTY_CACHE_MEMAVAIL_GIB=2.5
# One torch.cuda.empty_cache() when a long prefill hands over to decode (1 = on; measured no decode gain, off).
DSV41_PREFILL_END_EMPTY_CACHE=0
